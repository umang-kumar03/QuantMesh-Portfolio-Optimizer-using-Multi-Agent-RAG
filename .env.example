# Export variables through your process manager or secure environment settings.
# The app does NOT load .env automatically. Never commit real credentials.
QUANTMESH_DB=.quantmesh/research.sqlite3
QUANTMESH_CACHE_DB=.quantmesh/market.sqlite3

# Yahoo Finance via yfinance requires no API key; see docs/data-sources.md.

# Optional Alpha Vantage end-of-day adjusted history (plan entitlement required).
# Endpoint: TIME_SERIES_DAILY_ADJUSTED, outputsize=full.
ALPHAVANTAGE_API_KEY=

# Optional LLM explanation; use the key for your selected provider only.
# Providers: openai (api.openai.com), groq (api.groq.com).
QUANTMESH_LLM_PROVIDER=groq
# Currently verified Groq model; OpenAI model namespace on Groq, not an OpenAI endpoint.
QUANTMESH_LLM_MODEL=openai/gpt-oss-20b
QUANTMESH_LLM_API_KEY=

# Default: private local-only app. Docker Compose requires multi-user mode.
QUANTMESH_AUTH_MODE=single-user
# Required for multi-user mode; provision using python -m quantmesh.manage_users.
QUANTMESH_USERS_FILE=
# Required raw local secret for multi-user HMAC signing: 32+ cryptographically random chars.
# NOT a proxy-placeholder credential. Generate securely; never paste in chat.
QUANTMESH_SESSION_SECRET=
# Compose host path (absolute): provisioned file mounted read-only as /run/quantmesh/users.json.
QUANTMESH_USERS_FILE_HOST=

# Production launcher requires multi-user mode and existing persistent directory.
# Keep local .env settings unchanged until preparing the production environment.
QUANTMESH_DEPLOYMENT=local
QUANTMESH_DATA_DIR=
# First-start-only seed file containing salted hashes; existing disk accounts are preserved.
QUANTMESH_BOOTSTRAP_USERS_FILE=

# Required by production launcher: explicit operator confirmation of durable LOCAL disk.
# Do not set this on free ephemeral hosts; this setting cannot make a disk persistent.
# Compose and paid Render disk configuration already set it. Local sample mode ignores it.
QUANTMESH_STORAGE_MODE=

# Explicit persistence selection. Default sqlite preserves existing local/Render/Compose modes.
QUANTMESH_BACKEND=sqlite
# For postgres: configure via platform secrets; schema/accounts must be provisioned first.
# Runtime uses a least-privilege role; use a separate protected owner connection for pg_admin.
# TLS hostname/certificate verification is enforced on non-loopback hosts.
QUANTMESH_DATABASE_URL=
