# Export variables through your process manager or secure environment settings.
# The app does NOT load .env automatically. Never commit real credentials.
QUANTMESH_DB=.quantmesh/research.sqlite3
QUANTMESH_CACHE_DB=.quantmesh/market.sqlite3

# Optional Alpha Vantage end-of-day adjusted history (plan entitlement required).
# Endpoint: TIME_SERIES_DAILY_ADJUSTED, outputsize=full.
ALPHAVANTAGE_API_KEY=

# Optional LLM explanation; use the key for your selected provider only.
# Providers: openai (api.openai.com), groq (api.groq.com).
QUANTMESH_LLM_PROVIDER=openai
QUANTMESH_LLM_MODEL=gpt-4o-mini
QUANTMESH_LLM_API_KEY=

# Default: private local-only app. Docker Compose requires multi-user mode.
QUANTMESH_AUTH_MODE=single-user
# Required for multi-user mode; provision using python -m quantmesh.manage_users.
QUANTMESH_USERS_FILE=
# Required raw local secret for multi-user HMAC signing: 32+ cryptographically random chars.
# NOT a proxy-placeholder credential. Generate securely; never paste in chat.
QUANTMESH_SESSION_SECRET=
# Compose host path (absolute): provisioned file mounted read-only as /run/quantmesh/users.json.
QUANTMESH_USERS_FILE_HOST=
