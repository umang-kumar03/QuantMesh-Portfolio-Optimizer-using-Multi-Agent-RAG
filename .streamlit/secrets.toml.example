# TEMPLATE ONLY. Enter real values in Community Cloud > App settings > Secrets.
# Never commit .streamlit/secrets.toml or connection credentials.
QUANTMESH_BACKEND = "postgres"
QUANTMESH_DEPLOYMENT = "production"
QUANTMESH_AUTH_MODE = "multi-user"
QUANTMESH_DATABASE_URL = "postgresql://APP_ROLE:REPLACE_PASSWORD@REPLACE_ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
QUANTMESH_SESSION_SECRET = "" # Required: generate a private random 32+ character value; empty fails closed.
QUANTMESH_LLM_PROVIDER = "groq"
QUANTMESH_LLM_MODEL = "openai/gpt-oss-20b"
# Optional; omit keys when using only sample/CSV/Yahoo/local research.
# QUANTMESH_LLM_API_KEY = "REPLACE_PRIVATELY"
# ALPHAVANTAGE_API_KEY = "REPLACE_PRIVATELY"

# Optional CA override; omit by default to use the runtime's pinned Certifi bundle.
# QUANTMESH_SSLROOTCERT = ""
# Explicit "system" uses native libpq roots, which may differ from Python's roots.
# Custom absolute PEM paths must exist inside Cloud, never a local Windows path.
