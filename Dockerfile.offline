# BuildKit named context "wheels" must contain host-verified Python 3.12 Linux wheels.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY --from=wheels / /wheels/
RUN pip install --no-index --find-links=/wheels quantmesh==0.2.0 && rm -rf /wheels && useradd --create-home --uid 10001 quantmesh && mkdir /data && chown quantmesh /data
COPY --chmod=0644 app.py ./
COPY --chmod=0644 .streamlit/config.toml ./.streamlit/config.toml
RUN chmod 0755 /app /app/.streamlit
USER quantmesh
ENV QUANTMESH_DB=/data/research.sqlite3
EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=3)"
CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501"]
